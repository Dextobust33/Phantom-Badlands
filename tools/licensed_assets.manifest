# Art this repo USES but may not REDISTRIBUTE. Not in git; restore from the private
# backup before building. Format: <path><TAB><min .png count><TAB><why>
# Regenerate counts with: bash tools/check_licensed_assets.sh --update

client/sprites/darkcave	2	darkcave - "cannot redistribute ... in any form"
client/sprites/darkcave_tiles	2	derived from darkcave
client/sprites/tilemap_pack	2	Henry Software Pixel Level (CC0) - identified 2026-09-11, left untracked with the bakes
client/sprites/pet-egg-pack	648	Hope2D v1.0 - no standalone redistribution
client/sprites/prop_floor32	11	bake - traced 100% to darkcave
client/sprites/free_floor32	5	bake - traced 81% to tilemap_pack
client/sprites/tile_floor32	22	bake - landmark art from darkcave/free_tiles + raven green_dungeon
client/sprites/egg_floor32	100	bake - pet-egg-pack eggs
client/sprites/raven	190	Raven Fantasy - no redistribution as a separate product
client/sprites/room_floor32	1	bake - the ROOM floor, cropped from shroom_chasm (Raven Fantasy)
client/sprites/decor32	1	bake - per-pack room DECOR from the Raven tilesets
client/sprites/tall32	1	bake - TWO-CELL props (lanterns, shrub) split into halves, from darkcave
client/sprites/sanctuary32	16	bake - Sanctuary interior pieces (tools/bake_sanctuary.py) from Raven interiors + cozy_home
